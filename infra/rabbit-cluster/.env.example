# Plantilla del .env del cluster RabbitMQ de la EC2 cn-rabbit.
# El despliegue real genera este archivo en la EC2 con el usuario y la contraseña
# generada por terraform (recuperable con: terraform output -raw rabbit_pass).
# NO commitear un .env real.
RABBIT_COOKIE=cambia-esta-cookie
RABBIT_USER=hotel
RABBIT_PASS=cambia-esta-contraseña

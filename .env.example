# ============================================================================
# Cloud Native I (DSY1107) - Plantilla de variables de entorno
# Esta plantilla se copia hacia ".env"
# NUNCA se sube ".env" con valores reales a Git
# ============================================================================

# --- Base de datos (MySQL local via docker-compose) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
# Por microservicio: h_usuario / h_reserva / h_servicio (override comun)
DB_NAME=h_usuario

# Password de root del contenedor MySQL local (docker-compose)
MYSQL_ROOT_PASSWORD=root

# --- Puertos de cada microservicio ---
SERVER_PORT=8081
# reserva=8081, servicio=8082, usuario=8083, bff=8084, rabbit-admin=8085

# --- RabbitMQ (rabbit-admin y productores de reserva/servicio; default guest/guest) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Para el broker local de tests (cn-rabbit-audit): 5680 / hotel / hotel123

# --- BFF: destino de cada microservicio (solo si se corre el BFF contra microservicios locales) ---
# MICROSERVICIOS_USUARIO_URL=http://localhost:8083
# MICROSERVICIOS_RESERVA_URL=http://localhost:8081
# MICROSERVICIOS_SERVICIO_URL=http://localhost:8082
# MICROSERVICIOS_TIMEOUT=4000

# --- Seguridad OAuth2 Resource Server (Azure Entra ID) ---
# Tenant ID (GUID público del tenant). Se arma la URL del issuer en
# application.properties: https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
AZURE_TENANT_ID=e34a6311-e69d-4a97-bedf-2ad7cc5455a0

# Audience del JWT (client ID de la app en Entra)
AZURE_AUDIENCE=46cda96c-1ab7-42af-a838-5ad46de31226

# Orígenes CORS permitidos por los microservicios (separados por coma)
# CORS_ORIGINS=http://localhost:5173

# El frontend (React/MSAL) usa su propio .env de Vite: ver Frontend/.env.example
# (VITE_API_BASE_URL). El resto de su configuración vive en environment.ts.
